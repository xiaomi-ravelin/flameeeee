&soc {
    xiaomi_touch {
        status = "okay";
        compatible = "xiaomi-touch";
        touch,name = "xiaomi-touch";
    };
};

&qupv3_se1_spi {
    status = "ok";
    qcom,xfer-timeout-offset = <2500>;

    touch@0 {
        compatible = "novatek,NVT-ts-spi","focaltech,fts";
        reg = <0>; //Same as CS ID
        status = "ok";

